name: "crnn_ocr"
platform: "onnxruntime_onnx"
max_batch_size: 64

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 32, -1 ]
  }
]

output [
  {
    name: "text_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "icon_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 8, 16, 32, 64 ]
  max_queue_delay_microseconds: 100
}

instance_group [
  {
    count: 2
    kind: KIND_GPU
    gpus: [ 0 ]
  },
  {
    count: 1
    kind: KIND_CPU
  }
]
